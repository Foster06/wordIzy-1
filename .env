# ╔══════════════════════════════════════════════════════════════╗
# ║                    WordIzy .env Configuration                 ║
# ╚══════════════════════════════════════════════════════════════╝
#
# This file contains secrets — NEVER commit it to GitHub.
# It's already in .gitignore, so it won't be pushed.
#
# When deploying to Vercel, add these same variables in:
#   Vercel Dashboard → Settings → Environment Variables


# ┌──────────────────────────────────────────────────────────────┐
# │  DATABASE (required)                                         │
# └──────────────────────────────────────────────────────────────┘
# Local development: uses a SQLite file in the project folder
DATABASE_URL="file:./db/custom.db"

# Production (Vercel): use Turso (hosted SQLite)
# Create a free database at https://turso.tech, then:
#   1. Run: turso db create wordizy
#   2. Run: turso db show wordizy --url        → copy the URL below
#   3. Run: turso db tokens create wordizy     → copy the token below
#   4. Run: bun run db:push                    → creates all tables
#TURSO_DATABASE_URL="libsql://wordizy-your-name.turso.io"
#TURSO_AUTH_TOKEN="your-turso-auth-token-here"


# ┌──────────────────────────────────────────────────────────────┐
# │  ADMIN PASSWORD (required — change this!)                    │
# └──────────────────────────────────────────────────────────────┘
# Password for the owner-only inbox (#/inbox) and analytics dashboard (#/dashboard)
# CHANGE THIS to a strong, unique password before deploying!
ADMIN_PASSWORD="W0rd!zy-Adm1n-2026-S3cure"


# ┌──────────────────────────────────────────────────────────────┐
# │  GOOGLE ADSENSE (optional)                                   │
# └──────────────────────────────────────────────────────────────┘
# Your AdSense publisher ID. Leave as XXXXXXXX to show placeholder ad slots.
# Get your ID at https://www.google.com/adsense
#NEXT_PUBLIC_ADSENSE_CLIENT="ca-pub-XXXXXXXXXXXXXXXX"


# ┌──────────────────────────────────────────────────────────────┐
# │  EMAIL NOTIFICATIONS (optional)                              │
# └──────────────────────────────────────────────────────────────┘
# When someone submits the contact form, send an email notification.
# Uses Resend (https://resend.com) — free tier: 100 emails/day.
# Leave empty to skip email notifications (messages still stored in database).
#RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
#NOTIFY_EMAIL="info.wordizy@proton.me"
